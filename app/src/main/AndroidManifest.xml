<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.tuusuario.trainapp">

    <!-- No INTERNET permission - offline first -->

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="tiramisu" />

    <!-- Foreground service for workout timer -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:targetApi="q" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="q" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"
        tools:targetApi="q" />

    <!-- Boot completed for backup scheduler -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibration for rest timer -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Exact alarms for notifications (Android 14+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="upside_down_cake" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:targetApi="upside_down_cake" />

    <!-- Read media for photo picking (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".TrainApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrainApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TrainApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for timer -->
        <service
            android:name=".workout.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|health"
            tools:targetApi="q" />

        <!-- WorkManager receiver for boot -->
        <receiver
            android:name="androidx.work.impl.utils.ForceStopRunnable$BroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- File provider for backup export/import -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>