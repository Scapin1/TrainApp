<resources>
    <!-- Base theme - AppCompat for Activity, Compose handles actual theming -->
    <style name="Theme.TrainApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- We use Compose for theming, this is just for the Activity window -->
        <item name="android:statusBarColor">@color/gray_950</item>
        <item name="android:navigationBarColor">@color/gray_950</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.TrainApp.Splash" parent="Theme.TrainApp">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenBackground">@color/gray_950</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>